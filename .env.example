# InvestBot environment configuration
# Copy to .env and fill in values. Never commit .env (the repo is public).

# Database
# Leave unset: the default is ~/investbot_data/investbot.db (local disk, outside the repo).
# A relative path such as sqlite:///investbot.db puts the DB in whatever directory you
# run from, which is how it ended up inside Google Drive before.
# DATABASE_URL=

# Reddit API (sentiment phase, leave blank for now)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=investbot/0.1

# Twitter/X (sentiment phase, leave blank for now)
TWITTER_BEARER_TOKEN=

# Logging
LOG_LEVEL=INFO
